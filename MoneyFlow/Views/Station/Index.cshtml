

<h3>Buscar Estación</h3>
<form method="post" class="mb-4">
    <div class="form-control mb-4">
        <div class="input-group">
            <input type="text" name="search" placeholder="Ingrese nombre o CR..." class="form-control" />
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </div>
    </div>
    <div class="form-control mb-4">
        <div class="card bg-light mb-3">
            <div class="card-body">
                <h5><i class="bi bi-file-earmark-spreadsheet"></i> Carga Masiva desde Excel o CSV</h5>
                <p class="small text-muted">Acepta Excel (<b>EstacionId_1, Estacion_1, Folio_1, Folio_2</b>) o el CSV exportado (<b>IdEstacion, Nombre, FoliosTotales</b>).</p>
                <input type="file" id="excelInput" class="form-control" accept=".xlsx, .xls, .csv" />
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="button" id="btnExportarExcel" class="btn btn-success btn-md" onclick="descargarReporte()" disabled>
                <i class="bi bi-file-earmark-excel"></i> EXPORTAR RESULTADOS A EXCEL
            </button>
            <button type="button" id="btnEliminarResultados" class="btn btn-outline-danger btn-md" onclick="eliminarResultados()" disabled>
                <i class="bi bi-trash"></i> ELIMINAR RESULTADOS
            </button>
        </div>
    </div>
</form>
<div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] role="alert">
            @TempData["Message"]
        </div>
    }
</div>
<table id="stationsTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>IdEstation</th>
            <th>CR</th>
            <th>LS</th>
            <th>Nombre</th>
            <th>Estación</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var station in Model)
        {
            <tr>
                <td>@station.IdEstacion</td>
                <td>@station.CR</td>
                <td>@station.LS</td>
                <td>@station.Nombre</td>
                <td>@station.Estacion</td>
                <td>
                    <a asp-action="GetReceipts" asp-route-ls="@station.LS" class="btn btn-sm btn-info">
                        <i class="bi bi-receipt"></i> Ver Recibos
                    </a>
                    <button type="button" class="btn btn-sm btn-success"
                            onclick="addToBulk('@station.LS', '@station.Nombre', '@station.CR')">
                        <i class="bi bi-plus-circle"></i> Agregar a Masivo
                    </button>
                    <a asp-action="GetAudits" asp-controller="Audit" asp-route-ls="@station.LS" class="btn btn-warning btn-sm">
                        <i class="bi bi-clipboard-data"></i> Auditorías
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<hr />
<div id="bulkArea" class="mt-5" style="display:none;">
    <h4><i class="bi bi-list-check"></i> Estaciones para Procesamiento Masivo</h4>
    <table class="table table-dark table-hover" id="selectedTable">
        <thead>
            <tr>
                <th style="width:30px"><input type="checkbox" id="chkSeleccionarTodos" /></th>
                <th>Estación</th>
                <th>CR</th>
                <th width="50%">Folios (Separados por coma)</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody id="bulkBody"></tbody>
    </table>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-info" onclick="startProcessing()">
            <i class="bi bi-play-fill"></i> PROCESAR TODAS
        </button>
        <button class="btn btn-warning" onclick="retrySeleccionados()">
            <i class="bi bi-arrow-repeat"></i> REINTENTAR SELECCIONADAS
        </button>
    </div>
</div>

@* <div id="loader" class="overlay" style="display:none;">
    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;"></div>
    <h4 class="text-white mt-3">Procesando estaciones remotas... por favor espere.</h4>
</div> *@
<div id="loader" class="overlay" style="display:none;">
    <div class="container text-center">
        <h4 class="text-white mb-4">Procesando Estaciones Remotas...</h4>
        <div class="progress" style="height: 30px;">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                 role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                0%
            </div>
        </div>
        <p id="progressStatus" class="text-white mt-2">Iniciando búsqueda...</p>
    </div>
</div>

<style>
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#stationsTable').DataTable({
                "pageLength": 10,
                "language": {
                    "search": "Buscar estación:",
                    "lengthMenu": "Mostrar _MENU_ registros",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ estaciones",
                    "paginate": {
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            // Seleccionar / deseleccionar todas las filas del área masiva
            $('#chkSeleccionarTodos').change(function () {
                $('.select-row').prop('checked', this.checked);
            });

            // Estado inicial de los botones exportar/eliminar
            verificarResultados();
        });

        /*New Functions*/
        // 1. Agregar a la tabla de abajo
        let hayResultados = false;

        function addToBulk(ls, nombre, cr, folios = "") {
            $('#bulkArea').show();
            $('#bulkBody').append(`
                <tr id="row-${ls}" class="station-row">
                    <td class="text-center"><input type="checkbox" class="select-row" data-ls="${ls}" /></td>
                    <td><b>${nombre}</b></td>
                    <td>${cr}</td>
                    <td>
                        <textarea class="form-control folio-data" data-ls="${ls}" data-nombre="${nombre}" data-cr="${cr}" rows="1">${folios}</textarea>
                    </td>
                    <td class="status-cell text-center">
                        <span class="badge badge-secondary">Pendiente</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-warning btn-sm btn-retry" style="display:none;" onclick="retrySingle('${ls}')">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="$('#row-${ls}').remove()">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `);
        }

        // Obtiene los datos (LS, Nombre, CR, FoliosCsv) de un conjunto de filas.
        function obtenerDatosDeFilas($rows) {
            const data = [];
            $rows.each(function() {
                const textarea = $(this).find('.folio-data');
                const val = textarea.val().trim();
                if (val !== "") {
                    data.push({
                        LS: String(textarea.attr('data-ls')),
                        Nombre: String(textarea.attr('data-nombre')),
                        CR: String(textarea.attr('data-cr')),
                        FoliosCsv: val
                    });
                }
            });
            return data;
        }

        // Envía una lista de estaciones al backend y monitorea el progreso.
        async function procesarEstaciones(data) {
            if (data.length === 0) {
                Swal.fire('Atención', 'Ingresa folios en al menos una estación', 'warning');
                return;
            }

            $('#loader').show();
            $('#progressBar').css('width', '0%').text('0%');
            $('#progressStatus').text('Iniciando búsqueda...');

            try {
                const response = await fetch('/Station/ProcessBulk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                const searchId = result.searchId;

                const interval = setInterval(async () => {
                    try {
                        const res = await fetch(`/Station/GetProgress?searchId=${searchId}`);
                        const progress = await res.json();

                        const percent = progress.percentage;
                        $('#progressBar').css('width', percent + '%').text(percent + '%');
                        $('#progressStatus').text(`Procesado: ${progress.current} de ${progress.total}`);

                        // Marcar Errores
                        if (progress.failedList) {
                            progress.failedList.forEach(ls => {
                                const row = $(`#row-${ls}`);
                                row.addClass('table-danger');
                                row.find('.status-cell').html('<span class="badge badge-danger">Error</span>');
                                row.find('.btn-retry').show();
                            });
                        }

                        if (percent >= 100) {
                            clearInterval(interval);

                            // LIMPIEZA: Quitamos las que NO están en la lista de fallidas
                            $('.station-row').each(function() {
                                const rowId = $(this).attr('id');
                                const ls = rowId.replace('row-', '');
                                if (!progress.failedList.includes(ls)) {
                                    $(this).fadeOut(800, function() {
                                        $(this).remove();
                                        if ($('#bulkBody tr').length === 0) {
                                            $('#bulkArea').fadeOut();
                                        }
                                    });
                                }
                            });

                            setTimeout(() => {
                                $('#loader').fadeOut();
                                $('#excelInput').val('');
                                verificarResultados();
                                Swal.fire('Proceso Finalizado', 'Se procesaron las estaciones. Las que ves en pantalla fallaron y pueden reintentarse.', 'success');
                            }, 2000);
                        }
                    } catch (e) { console.error(e); }
                }, 1000);

            } catch (err) {
                Swal.fire('Error', 'No se pudo iniciar el proceso.', 'error');
                $('#loader').hide();
            }
        }

        // Procesa todas las estaciones de la tabla.
        async function startProcessing() {
            const data = obtenerDatosDeFilas($('.station-row'));
            await procesarEstaciones(data);
        }

        // Reintenta una sola estación.
        async function retrySingle(ls) {
            const row = $(`#row-${ls}`);
            row.find('.status-cell').html('<span class="badge badge-secondary">Pendiente</span>');
            row.find('.btn-retry').hide();
            const data = obtenerDatosDeFilas(row);
            await procesarEstaciones(data);
        }

        // Reintenta las estaciones seleccionadas (checkboxes).
        async function retrySeleccionados() {
            const $seleccionadas = $('.select-row:checked').closest('.station-row');
            if ($seleccionadas.length === 0) {
                Swal.fire('Atención', 'Selecciona al menos una estación para reintentar.', 'warning');
                return;
            }
            $seleccionadas.each(function() {
                $(this).find('.status-cell').html('<span class="badge badge-secondary">Pendiente</span>');
                $(this).find('.btn-retry').hide();
            });
            const data = obtenerDatosDeFilas($seleccionadas);
            await procesarEstaciones(data);
        }

        document.getElementById('excelInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const esCsv = /\.csv$/i.test(file.name);
            const reader = new FileReader();

            reader.onload = function(e) {
                let jsonData;

                try {
                    if (esCsv) {
                        const texto = String(e.target.result).replace(/^\uFEFF/, '');
                        const workbook = XLSX.read(texto, { type: 'string' });
                        jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]]);
                    } else {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]]);
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'No se pudo leer el archivo. Verifica el formato.', 'error');
                    return;
                }

                procesarDatos(jsonData);
            };

            if (esCsv) {
                reader.readAsText(file);
            } else {
                reader.readAsArrayBuffer(file);
            }
        });

        function procesarDatos(jsonData) {
            const groupedData = jsonData.reduce((acc, row) => {
                const id = row["EstacionId_1"] || row["IdEstacion"]; // Detecta ambos nombres
                const nombre = row["Estacion_1"] || row["Nombre"];

                if (id) {
                    if (!acc[id]) {
                        acc[id] = {
                            id: id,
                            nombre: nombre || `Estacion ${id}`,
                            folios: new Set()
                        };
                    }

                    // 1. Folios desde la columna FoliosTotales (CSV exportado: "f1,f2")
                    const foliosTotales = row["FoliosTotales"];
                    if (foliosTotales !== undefined && foliosTotales !== null) {
                        const limpio = limpiarFolio(foliosTotales);
                        const partes = String(limpio).split(',');
                        partes.forEach(parte => {
                            const folio = parte.trim();
                            if (folio !== "") {
                                const folioProcesado = replaceDigit(folio);
                                if (folioProcesado) acc[id].folios.add(folioProcesado);
                            }
                        });
                    }

                    // 2. Folios desde columnas Folio_1 / Folio_2 / Folio (Excel original)
                    const columnasFolio = ["Folio_1","Folio_2", "Folio"];
                    columnasFolio.forEach(col => {
                        const valorCelda = row[col];

                        // Verificamos que la celda tenga contenido (que no sea undefined, null o vacío)
                        if (valorCelda !== undefined && valorCelda !== null && String(valorCelda).trim() !== "") {
                            const folioProcesado = replaceDigit(valorCelda);
                            if (folioProcesado) {
                                acc[id].folios.add(folioProcesado);
                            }
                        }
                    });
                }
                return acc;
            }, {});

            // 2. Limpiamos y preparamos la carga
            $('#bulkBody').empty();

            // 3. Enviamos los IDs al servidor para obtener CR y LS automáticamente
            const idsParaValidar = Object.keys(groupedData);

            if (idsParaValidar.length > 0) {
                const finalData = {};
                for (const id in groupedData) {
                    finalData[id] = {
                        id: groupedData[id].id,
                        nombre: groupedData[id].nombre,
                        foliosCsv: Array.from(groupedData[id].folios).join(',') // Convertimos el Set a Array y luego a CSV
                    };
                }
                obtenerMetadataEstaciones(idsParaValidar, finalData);
            } else {
                Swal.fire('Atención', 'No se encontraron IDs para procesar.', 'warning');
            }
        }

        // Quita el wrapper ="" que usa la exportación CSV para forzar texto en Excel.
        function limpiarFolio(valor) {
            if (valor === undefined || valor === null) return "";
            let s = String(valor).trim();
            if (s.startsWith('="') && s.endsWith('"')) {
                s = s.slice(2, -1);
            }
            return s;
        }

        function replaceDigit(digit) {
            if (!digit) return "";

            const isDigit = String(digit);
            const folionew = isDigit.slice(0, -1);
            console.log(`Reemplazando último dígito de ${digit}, que es ${folionew}`);
            return folionew;
        }

        // Función para obtener CR y LS desde el servidor usando los IDs del Excel
        async function obtenerMetadataEstaciones(ids, groupedData) {
            try {
                const response = await fetch('/Station/GetStationsMetadata', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(ids)
                });

                const metadata = await response.json();
                console.log("Datos recibidos:", metadata);

                metadata.forEach(m => {
                    // USAR idEstacion (con minúscula al inicio) porque así viene el JSON
                    const estacion = groupedData[m.idEstacion];

                    if (estacion) {
                        // USAR m.ls y m.cr (en minúsculas)
                        // Usamos el nombre que viene del Excel (estacion.nombre)
                        // y los folios agrupados (estacion.folios)
                        addToBulk(
                            m.ls,
                            estacion.nombre,
                            m.cr,
                            estacion.foliosCsv
                        );
                    }
                });

                // if(metadata.length > 0) {
                //     Swal.fire('Carga Lista', `Se agruparon ${metadata.length} estaciones con éxito.`, 'success');
                // } else {
                //     Swal.fire('Atención', 'No se encontró información técnica para los IDs del Excel.', 'warning');
                // }

                //
                $('#bulkArea').show();
                Swal.fire('Carga Lista', `Se agruparon ${metadata.length} estaciones con éxito.`, 'success');

            } catch (err) {
                console.error("Error en obtenerMetadataEstaciones:", err);
                Swal.fire('Error', 'No se pudo obtener la información de las instancias (LS/CR).', 'error');
            }
        }

        function actualizarBotonesResultados() {
            $('#btnExportarExcel').prop('disabled', !hayResultados);
            $('#btnEliminarResultados').prop('disabled', !hayResultados);
        }

        async function verificarResultados() {
            try {
                const res = await fetch('/Station/ObtenerConteoResultados');
                const data = await res.json();
                hayResultados = data.total > 0;
                actualizarBotonesResultados();
            } catch (e) {
                console.error(e);
            }
        }

        function descargarReporte() {
            if (!hayResultados) {
                Swal.fire({
                    title: 'Sin datos',
                    text: 'No hay resultados para exportar.',
                    icon: 'info'
                });
                return;
            }

            window.location.href = '/Station/DownloadExcel';
        }

        async function eliminarResultados() {
            const confirmacion = await Swal.fire({
                title: '¿Eliminar resultados?',
                text: 'Se eliminarán todos los resultados de la búsqueda masiva.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirmacion.isConfirmed) return;

            try {
                const res = await fetch('/Station/EliminarResultados', { method: 'POST' });
                const result = await res.json();

                if (res.ok && result.success) {
                    hayResultados = false;
                    actualizarBotonesResultados();
                    Swal.fire('Eliminado', result.message, 'success');
                } else {
                    Swal.fire('Error', result.message || 'No se pudo eliminar la información.', 'error');
                }
            } catch (e) {
                console.error(e);
                Swal.fire('Error', 'No se pudo eliminar la información.', 'error');
            }
        }
    </script>
}
