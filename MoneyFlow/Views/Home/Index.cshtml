@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @if(User.Identity!.IsAuthenticated)
    {
        <h1 class="display-4">Welcome, @User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault()</h1>
        <p class="lead">You are logged in. Explore your dashboard and manage your finances.</p>
    }
</div>
