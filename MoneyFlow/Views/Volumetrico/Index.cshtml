@{
    ViewData["Title"] = "Aclaraciones Volumétricas";

    var meses = new[]
    {
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    };
}

<div class="row">
    <div class="col-sm-6">
        <h2><i class="bi bi-database-fill-gear"></i> Aclaraciones Volumétricas</h2>
    </div>
</div>
<hr />

<div class="card bg-light mb-4">
    <div class="card-body">
        <h5 class="mb-3">1. Selecciona el archivo Excel volumétrico</h5>
        <p class="small text-muted">
            El archivo debe contener la hoja <b>FINAL</b> y las columnas: <b>CR</b>,
            <b>Descripcion</b> y <b>Aclaraciones Json</b> (o <b>Aclaraciones_Json</b>).
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted">Archivo .xlsx</label>
                <input type="file" id="excelInput" class="form-control" accept=".xlsx" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Mes</label>
                <select id="selectMes" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Mes)">@meses[m - 1]</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Año</label>
                <select id="selectAño" class="form-select">
                    @for (int a = 2024; a <= 2030; a++)
                    {
                        <option value="@a" selected="@(a == Model.Año)">@a</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="button" id="btnCargar" class="btn btn-primary w-100" onclick="cargarExcel()">
                    <i class="bi bi-eye"></i> Cargar y previsualizar
                </button>
            </div>
        </div>
        <div id="erroresArea" class="mt-3" style="display:none;"></div>
    </div>
</div>

<div class="card mb-4" id="previewCard" style="display:none;">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                2. Vista previa
                (<span id="totalFilas">0</span> filas,
                <span id="totalAclaraciones">0</span> con aclaración)
            </h5>
            <span class="badge bg-secondary">Tabla: <span id="nombreTablaPreview"></span></span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm" id="previewTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>CR</th>
                        <th>EESS</th>
                        <th>Descripcion</th>
                        <th>Aclaraciones</th>
                        <th>Auditor</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <p class="small text-muted">Mostrando las primeras 50 filas.</p>
    </div>
</div>

<div class="card mb-4" id="accionesCard" style="display:none;">
    <div class="card-body">
        <h5 class="mb-3">3. Acciones</h5>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" id="btnProcesar" class="btn btn-success" onclick="procesar()">
                <i class="bi bi-check-lg"></i> Procesar e insertar en clarifications
            </button>
            <button type="button" id="btnEliminarTabla" class="btn btn-outline-danger" onclick="eliminarTablaTemporal()">
                <i class="bi bi-trash"></i> Eliminar tabla temporal
            </button>
        </div>
    </div>
</div>

<div class="card mb-4 border-danger">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-1"><i class="bi bi-database"></i> Aclaraciones registradas</h5>
                <span class="small text-muted">Tabla <code>[volumetric].[clarifications]</code></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label for="clarificationIdInicio" class="form-label mb-0 text-nowrap small">Iniciar ClarificationId en</label>
                <input type="number" id="clarificationIdInicio" class="form-control form-control-sm" style="width:130px;" min="1" step="1" placeholder="Ej. 31164">
            </div>
            <button type="button" id="btnScriptClarif" class="btn btn-outline-primary" onclick="generarScript()">
                <i class="bi bi-filetype-sql"></i> Generar script INSERTs
            </button>
            <button type="button" id="btnTruncar" class="btn btn-danger" onclick="truncarClarifications()">
                <i class="bi bi-eraser"></i> Truncar clarifications
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="mb-3">Tablas volumétricas existentes</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm" id="tablasTable">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Fecha de creación</th>
                        <th>Registros</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="mb-3">Log de operaciones</h5>
        <textarea id="logArea" class="form-control" rows="6" readonly></textarea>
    </div>
</div>

<div id="loader" class="overlay" style="display:none;">
    <div class="container text-center">
        <div class="spinner-border text-light" role="status"></div>
        <h5 class="text-white mt-3">Procesando...</h5>
        <div class="progress mt-3" style="height: 30px;">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                 role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
        </div>
        <p id="progressStatus" class="text-white mt-2"></p>
    </div>
</div>

<style>
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@section Scripts {
    <script>
        let nombreTablaActual = '';

        $(document).ready(function () {
            cargarTablas();

            const ultimo = localStorage.getItem('volumetric.clarificationIdInicio');
            if (ultimo) {
                document.getElementById('clarificationIdInicio').value = ultimo;
            }
        });

        function log(mensaje) {
            const area = document.getElementById('logArea');
            const ts = new Date().toLocaleTimeString();
            area.value = `[${ts}] ${mensaje}\n` + area.value;
        }

        async function cargarExcel() {
            const input = document.getElementById('excelInput');
            const erroresArea = document.getElementById('erroresArea');

            if (!input.files || input.files.length === 0) {
                Swal.fire('Atención', 'Selecciona un archivo Excel.', 'warning');
                return;
            }

            const mes = document.getElementById('selectMes').value;
            const año = document.getElementById('selectAño').value;

            const formData = new FormData();
            formData.append('archivo', input.files[0]);

            $('#loader').show();
            erroresArea.style.display = 'none';
            erroresArea.innerHTML = '';

            try {
                const response = await fetch(`/Volumetrico/CargarExcel?mes=${mes}&año=${encodeURIComponent(año)}`, {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (!result.success) {
                    mostrarErrores(result.errores);
                    ocultarPreview();
                    log(`Error cargando ${input.files[0].name}`);
                    return;
                }

                nombreTablaActual = result.nombreTabla;
                renderizarPreview(result);
                log(`Archivo cargado: ${input.files[0].name} -> tabla ${result.nombreTabla} (${result.filasLeidas} filas)`);
                Swal.fire('Carga lista', `Se leyeron ${result.filasLeidas} filas. Tabla temporal: ${result.nombreTabla}.`, 'success');
            } catch (err) {
                console.error(err);
                log('Error de red al cargar el archivo');
                Swal.fire('Error', 'No se pudo procesar el archivo.', 'error');
            } finally {
                $('#loader').hide();
            }
        }

        function renderizarPreview(result) {
            const tbody = document.querySelector('#previewTable tbody');
            tbody.innerHTML = '';

            (result.filasPreview || []).forEach(f => {
                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td>${escapeHtml(f.rowNumber)}</td>
                        <td>${escapeHtml(f.cr)}</td>
                        <td>${escapeHtml(f.eess)}</td>
                        <td>${escapeHtml(f.descripcion)}</td>
                        <td>${escapeHtml(f.aclaracionesJson)}</td>
                        <td>${escapeHtml(f.auditor)}</td>
                    </tr>
                `);
            });

            document.getElementById('totalFilas').textContent = result.filasLeidas;
            document.getElementById('totalAclaraciones').textContent = result.totalConAclaracion;
            document.getElementById('nombreTablaPreview').textContent = result.nombreTabla;
            document.getElementById('previewCard').style.display = '';
            document.getElementById('accionesCard').style.display = '';

            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#previewTable')) {
                $('#previewTable').DataTable().destroy();
            }
            $('#previewTable').DataTable({ pageLength: 10, order: [[0, 'asc']], language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' } });
        }

        function ocultarPreview() {
            nombreTablaActual = '';
            document.getElementById('previewCard').style.display = 'none';
            document.getElementById('accionesCard').style.display = 'none';
        }

        function mostrarErrores(errores) {
            const area = document.getElementById('erroresArea');
            area.style.display = '';
            area.innerHTML = `
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        ${(errores || []).map(e => `<li>${escapeHtml(e)}</li>`).join('')}
                    </ul>
                </div>
            `;
        }

        async function procesar() {
            if (!nombreTablaActual) {
                Swal.fire('Atención', 'Primero carga un archivo.', 'warning');
                return;
            }

            const confirmacion = await Swal.fire({
                title: '¿Procesar e insertar?',
                text: 'Se limpiará la tabla volumetric.clarifications y se insertarán los registros transformados. Esta operación es irreversible.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, procesar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirmacion.isConfirmed) return;

            const mes = document.getElementById('selectMes').value;
            const año = document.getElementById('selectAño').value;

            $('#loader').show();
            resetProgress();
            updateProgressBar(20, 'Ejecutando transformaciones...');

            try {
                const response = await fetch(`/Volumetrico/Procesar?tabla=${encodeURIComponent(nombreTablaActual)}&mes=${mes}&año=${encodeURIComponent(año)}`, {
                    method: 'POST'
                });
                const result = await response.json();

                if (!response.ok || !result.success) {
                    log(`Error al procesar: ${result.message}`);
                    Swal.fire('Error', result.message || 'No se pudo procesar.', 'error');
                    return;
                }

                updateProgressBar(100, 'Completado');
                log(result.message);
                Swal.fire('Procesado', result.message, 'success');
                cargarTablas();
            } catch (err) {
                console.error(err);
                log('Error de red al procesar');
                Swal.fire('Error', 'No se pudo procesar.', 'error');
            } finally {
                $('#loader').hide();
            }
        }

        async function generarScript() {
            const input = document.getElementById('clarificationIdInicio');
            const inicio = parseInt(input.value, 10);

            if (!Number.isInteger(inicio) || inicio < 1) {
                Swal.fire('Atención', 'Ingresa un ClarificationId inicial válido (entero mayor o igual a 1).', 'warning');
                input.focus();
                return;
            }

            $('#loader').show();
            try {
                const response = await fetch(`/Volumetrico/GenerarScript?clarificationIdInicio=${inicio}`);
                if (!response.ok) {
                    const errText = await response.text();
                    throw new Error(errText || 'Error al generar el script.');
                }

                const blob = await response.blob();
                const texto = await blob.text();

                const rango = texto.match(/-- Rango de ClarificationId:\s*(\d+)\s*-\s*(-?\d+)/);
                const filas = texto.match(/-- Filas exportadas:\s*(\d+)/);

                let siguiente = inicio;
                let msg = 'Script generado.';
                if (rango) {
                    msg = `Script generado: ${rango[1]} → ${rango[2]}`;
                    siguiente = parseInt(rango[2], 10) + 1;
                }
                if (filas) {
                    msg += ` (${filas[1]} inserts)`;
                }

                localStorage.setItem('volumetric.clarificationIdInicio', String(siguiente));

                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `clarifications_inserts_desde_${inicio}.sql`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);

                log(msg);
                Swal.fire('Listo', `${msg}. Siguiente consecutivo: ${siguiente}.`, 'success');
            } catch (err) {
                console.error(err);
                Swal.fire('Error', err.message || 'No se pudo generar el script.', 'error');
            } finally {
                $('#loader').hide();
            }
        }

        async function truncarClarifications() {
            const confirmacion = await Swal.fire({
                title: '¿Truncar clarifications?',
                text: 'Se eliminarán TODOS los registros de [volumetric].[clarifications]. Esta operación es irreversible.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, truncar',
                confirmButtonColor: '#d33',
                cancelButtonText: 'Cancelar'
            });

            if (!confirmacion.isConfirmed) return;

            $('#loader').show();
            try {
                const response = await fetch('/Volumetrico/TruncarClarifications', { method: 'POST' });
                const result = await response.json();

                if (response.ok && result.success) {
                    log(result.message);
                    Swal.fire('Truncada', result.message, 'success');
                } else {
                    Swal.fire('Error', result.message || 'No se pudo truncar.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'No se pudo truncar la tabla.', 'error');
            } finally {
                $('#loader').hide();
            }
        }

        async function eliminarTablaTemporal() {
            if (!nombreTablaActual) {
                Swal.fire('Atención', 'Primero carga un archivo.', 'warning');
                return;
            }

            const confirmacion = await Swal.fire({
                title: '¿Eliminar tabla temporal?',
                text: `Se eliminará la tabla ${nombreTablaActual}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirmacion.isConfirmed) return;

            try {
                const response = await fetch(`/Volumetrico/LimpiarTabla?tabla=${encodeURIComponent(nombreTablaActual)}`, { method: 'DELETE' });
                const result = await response.json();

                if (response.ok && result.success) {
                    log(result.message);
                    Swal.fire('Eliminada', result.message, 'success');
                    ocultarPreview();
                    cargarTablas();
                } else {
                    Swal.fire('Error', result.message || 'No se pudo eliminar.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'No se pudo eliminar la tabla.', 'error');
            }
        }

        async function cargarTablas() {
            try {
                const res = await fetch('/Volumetrico/ObtenerTablas');
                const tablas = await res.json();
                if (!res.ok || !Array.isArray(tablas)) {
                    console.warn('ObtenerTablas no devolvió una lista válida:', tablas);
                    return;
                }
                renderizarTablas(tablas);
            } catch (e) {
                console.error(e);
            }
        }

        function renderizarTablas(tablas) {
            const tbody = document.querySelector('#tablasTable tbody');
            tbody.innerHTML = '';

            (tablas || []).forEach(t => {
                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td><code>${escapeHtml(t.name)}</code></td>
                        <td>${escapeHtml(new Date(t.createDate).toLocaleString())}</td>
                        <td>${escapeHtml(t.rowCount)}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarTabla('${escapeHtml(t.name)}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });
        }

        async function eliminarTabla(nombre) {
            const confirmacion = await Swal.fire({
                title: '¿Eliminar tabla temporal?',
                text: `Se eliminará la tabla ${nombre}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirmacion.isConfirmed) return;

            try {
                const response = await fetch(`/Volumetrico/LimpiarTabla?tabla=${encodeURIComponent(nombre)}`, { method: 'DELETE' });
                const result = await response.json();

                if (response.ok && result.success) {
                    log(result.message);
                    cargarTablas();
                } else {
                    Swal.fire('Error', result.message || 'No se pudo eliminar.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'No se pudo eliminar la tabla.', 'error');
            }
        }

        function resetProgress() {
            $('#progressBar').css('width', '0%').text('0%');
            $('#progressStatus').text('');
        }

        function updateProgressBar(percentage, status) {
            $('#progressBar').css('width', percentage + '%').text(percentage + '%');
            $('#progressStatus').text(status || '');
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
}
