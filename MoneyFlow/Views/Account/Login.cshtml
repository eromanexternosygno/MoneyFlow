@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoneyFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.21/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="login-card">
        <h2 class="mb-5 fw-normal">Gax Panel</h2>

        <div class="icon-circle">
            <i class="bi bi-person"></i>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="email" class="form-control" placeholder="Email" required name="Email" asp-for="Email">
            <span asp-validation-for="Email" class="text-danger"></span>
            <input type="password" class="form-control" placeholder="Password" required name="Password" asp-for="Password">
            <span asp-validation-for="Password" class="text-danger"></span>

            <div class="options-row">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Remember Me
                    </label>
                </div>
                @* <a href="#">Forgot Password</a> *@
            </div>

            <button type="submit" class="btn btn-get-started shadow">Access</button>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.21/dist/sweetalert2.all.min.js"></script>
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                   Swal.fire({
                        icon: 'error',
                        title: 'Login Failed',
                        text: '@TempData["ErrorMessage"]'
                    });
            </text>
        }
    </script>
</body>
</html>
