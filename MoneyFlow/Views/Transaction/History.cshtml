@{
}

<div class="row">
    <div class="row align-content-center">
        <h2>Transaction History</h2>
    </div>
    <div class="row align-items-end">
        <div class="col-sm-3">
            <div class="mb-2">
                <label for="dateRange" class="form-label>">Start Date:</label>
                <input type="date" class="form-control" id="txtStartDate" />
            </div>
        </div>
        <div class="col-sm-3">
            <div class="mb-2">
                <label for="dateRange" class="form-label>">End Date:</label>
                <input type="date" class="form-control" id="txtEndDate" />
            </div>
        </div>
        <div class="col-sm-3">
            <div class="mb-2">
                <button type="button" class="btn btn-primary" onclick="SearchTransactions();">Search</button>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <!--Alert-->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] role="alert">
            @TempData["Message"]
        </div>
    }
    <div class="row">
        <div class="col-sm-12">
            <table id="transactionsHistoryTable" class="table table-bordered table-striped">
            </table>
        </div>
    </div>
    <!--Delete Modal-->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-action="Delete" asp-controller="Service" method="post">

                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="deleteId" name="id" />
                        <p id="deleteMessage"></p>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
    <!--Overlay (loader)-->
    <div id="loaderSearch" class="search-overlay" style="display:none;">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="text-white mt-3">Searching Transactions...</h4>
        </div>
    </div>
</div>
<!--Css Overlay-->
@section Styles {
    <style>
        .search-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
}
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        let tableDataConfiguration;

        $(document).ready(function () {
            //Params init
            const today = new Date().toISOString().split('T')[0];
            $('#txtStartDate').val(today);
            $('#txtEndDate').val(today);

            // Initialize DataTable with AJAX source
            tableDataConfiguration = $('#transactionsHistoryTable').DataTable({
                "processing": true,
                "ajax":{
                    "url": "@Url.Action("GetHistoryTransactions", "Transaction")",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns":[
                    { "data": "date", "title": "Date",
                        "render": function (data, type, row) {
                            if(type === 'sort'){
                                var p = data.split('/');
                                return p[2] + p[1] + p[0];
                            }
                            return data;
                        }, 
                    },
                    { "data": "month", "title": "Month"},
                    { "data": "typeService", "title": "Type of Service" },
                    { "data": "service", "title": "Service"  },
                    { 
                        "data": "amount", 
                        "title": "Amount",
                        "render": function (data, type, row) {
                            return '$' + parseFloat(data).toFixed(2);
                        }
                    }
                ],
                "pageLength": 10,
                "language": {
                    "search": "Buscar Transacción:",
                    "lengthMenu": "Mostrar _MENU_ registros",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ de _ transacciones",
                    "paginate": {
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });
        });

        async function SearchTransactions(){
            // Function async to search history transactions by date range
                const startDate = $('#txtStartDate').val();
                const endDate = $('#txtEndDate').val();
    
                if(!startDate || !endDate){
                    Swal.fire({
                        icon:'warning',
                        title:'Please fill in both date fields',
                        text:'Start Date and End Date are required'
                    });
                    return; // Stop execution if validation fails
                } else if (startDate > endDate) {
                    Swal.fire({
                        icon:'warning',
                        title:'Invalid date range',
                        text:'Start Date cannot be later than End Date'
                    });
                    return; // Stop execution if validation fails
                }

                // show loader
                $('#loaderSearch').show();
                // Reload DataTable with new AJAX source including date range parameters
                const newUrl = `@Url.Action("GetHistoryTransactions", "Transaction")?startDate=${startDate}&endDate=${endDate}`;
                //tableDataConfiguration.ajax.url(`@Url.Action("GetHistoryTransactions", "Transaction")?startDate=${startDate}&endDate=${endDate}`).load();
                // hide loader after data is loaded
                tableDataConfiguration.ajax.url(newUrl).load(function(){
                    $('#loaderSearch').hide();
                });
        }



        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            var serviceId = button.getAttribute('data-id');
            var serviceName = button.getAttribute('data-name');

            var hiddenInput = deleteModal.querySelector('#deleteId');
            var message = deleteModal.querySelector('#deleteMessage');

            hiddenInput.value = serviceId;
            message.textContent = "¿Estás seguro que deseas eliminar el servicio: " + serviceName + "?";
        });
    </script>
}
